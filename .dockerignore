# Dependencies — reinstalled inside the image from the lockfile
node_modules
**/node_modules

# Build outputs — rebuilt inside the image
.next
**/.next
dist
build
coverage

# Git and CI
.git
.github

# Environment files — never bake secrets into the image
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Docker files themselves
Dockerfile
.dockerignore

# Local OS files
.DS_Store
Thumbs.db
