{
  "name": "ai-showdown",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "npm exec --workspace=web -- next typegen && npm exec --workspace=web -- tsc --noEmit",
    "test": "npm run test --workspace=web",
    "sandbox:build": "docker build -t ai-showdown-sandbox:py3.12 sandbox/",
    "sandbox:check": "node --test scripts/sandbox-persistence-check.mjs",
    "sandbox:render:build": "docker build -t ai-showdown-render:chromium sandbox/render/",
    "briefs:validate": "node scripts/briefs-validate.mjs",
    "dev:pipeline": "node scripts/dev-pipeline-run.mjs",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:seed:briefs": "supabase db push --include-seed"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "supabase": "^2.122.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1"
  }
}
