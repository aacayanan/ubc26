{
  "name": "ai-showdown",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "npm exec --workspace=web -- next typegen && npm exec --workspace=web -- tsc --noEmit",
    "test": "tsx --tsconfig apps/web/tsconfig.json --conditions=react-server --test \"apps/**/*.test.ts\"",
    "db:link": "supabase link",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "supabase": "^2.122.1",
    "tsx": "^4.23.15"
  }
}
