# Copy to .env.local and fill in real values. .env.local is gitignored.

# Public configuration (accessible to the browser)
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Private configuration (server only) — never prefix these with NEXT_PUBLIC_
# Supabase service-role key. Bypasses RLS — server-only, never in client
# components. Not needed yet: every current query runs under RLS with the
# signed-in user's session (F6+ admin paths will use it).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Auth setup (ticket #4) — all of this is Supabase dashboard configuration,
# never app configuration:
# - Email confirmation must be disabled (Authentication -> Sign In / Providers
#   -> Email -> Confirm email) or sign-up returns no session.
# - Web3 / Sign in with Solana must be enabled (Authentication -> Providers ->
#   Web3 -> Solana) to match supabase/config.toml's [auth.web3.solana].
# - Every provider credential lives in the Supabase dashboard. Nothing
#   provider-related belongs in this file, and no secret reaches the bundle.
# Full setup steps: see "Authentication" in the root README.
