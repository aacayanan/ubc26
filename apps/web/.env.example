# Copy to .env.local and fill in real values. .env.local is gitignored.

# Public configuration (accessible to the browser)
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Private configuration (server only) — never prefix these with NEXT_PUBLIC_
# Supabase service-role key. Bypasses RLS — server-only, never in client
# components. Required from F13 on: evaluation result writes
# (model_executions, test_results) have no write policy, so only the service
# role can insert them.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Evaluation sandbox (F13) — server only.
# The image MUST be digest-pinned: a tag would silently re-pull, and the same
# solution could then be judged by a different sandbox. Build it with
# `npm run sandbox:build`, then paste the digest here:
#   docker image inspect ai-showdown-sandbox:py3.12 \
#     --format '{{index .RepoDigests 0}}'
SANDBOX_IMAGE=ai-showdown-sandbox:py3.12@sha256:REPLACE_WITH_BUILT_DIGEST
DOCKER_BIN=docker

# Optional overrides — defaults shown. The runner needs access to a Docker
# daemon: a mounted socket locally, or a sidecar at deploy time (F28).
# SANDBOX_MEMORY_MB=256
# SANDBOX_CPUS=0.5
# SANDBOX_PIDS_LIMIT=64
# SANDBOX_WALL_CLOCK_MS=120000

# Render sandbox (F12/F14) — server only.
# Visual briefs are rendered by headless Chromium, not the Python runner above.
# Build with `npm run sandbox:render:build`, then pin its digest the same way:
#   docker image inspect ai-showdown-render:chromium \
#     --format '{{index .RepoDigests 0}}'
RENDER_SANDBOX_IMAGE=ai-showdown-render:chromium@sha256:REPLACE_WITH_BUILT_DIGEST
# Optional overrides — defaults shown. Chromium needs more headroom than the
# Python runner; these do not affect the Python image.
# RENDER_SANDBOX_MEMORY_MB=1024
# RENDER_SANDBOX_CPUS=1
# RENDER_SANDBOX_PIDS_LIMIT=256
# RENDER_SANDBOX_TMPFS_MB=256
# RENDER_SANDBOX_WALL_CLOCK_MS=90000
# RENDER_SANDBOX_FRAME_TIMEOUT_MS=10000
# RENDER_SANDBOX_MAX_STDOUT_BYTES=67108864

# OpenRouter tuning (F16) — all optional; the defaults are prod-safe. The model
# lineup is NOT configured here: it lives in the llm_models table.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=60000
# OPENROUTER_MAX_ATTEMPTS=3
# OPENROUTER_FORFEIT_THRESHOLD=3

# Internal jobs (F11/F17) — server only.
# Shared secret for the internal endpoints under /api/internal/jobs. The
# deadline job locks rounds whose prediction deadline has passed; the pipeline
# job drives locked rounds through chunked generation, previews, gating and the
# judge. A scheduler or an operator calls them with
# `x-internal-job-secret: <this value>`. Unset means every internal endpoint
# refuses to run (fail closed), which is the right state for a checkout that
# has no scheduler.
INTERNAL_JOB_SECRET=generate-a-long-random-string

# Chunked generation (F17) — all optional; the defaults are the demo policy.
# Every model in a round receives the identical policy, and it is recorded on
# each execution, so changing these changes what future rounds were run under.
# CHUNK_MAX_TOKENS=2048
# CHUNK_MAX_CHUNKS=3

# Auth setup (ticket #4) — all of this is Supabase dashboard configuration,
# never app configuration:
# - Email confirmation must be disabled (Authentication -> Sign In / Providers
#   -> Email -> Confirm email) or sign-up returns no session.
# - Web3 / Sign in with Solana must be enabled (Authentication -> Providers ->
#   Web3 -> Solana) to match supabase/config.toml's [auth.web3.solana].
# - Every provider credential lives in the Supabase dashboard. Nothing
#   provider-related belongs in this file, and no secret reaches the bundle.
# Full setup steps: see "Authentication" in the root README.
